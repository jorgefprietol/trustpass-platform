{
  "components": {
    "schemas": {
      "Credential": {
        "properties": {
          "category": {
            "title": "Category",
            "type": "string"
          },
          "expires_at": {
            "title": "Expires At",
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "revoked"
            ],
            "title": "Status",
            "type": "string"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          },
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "id",
          "subject",
          "category",
          "status",
          "expires_at",
          "token"
        ],
        "title": "Credential",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IssueRequest": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "enum": [
              "facility-access",
              "professional-certification",
              "event-pass"
            ],
            "title": "Category",
            "type": "string"
          },
          "subject": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,79}$",
            "title": "Subject",
            "type": "string"
          },
          "valid_for_seconds": {
            "default": 86400,
            "maximum": 2592000.0,
            "minimum": 60.0,
            "title": "Valid For Seconds",
            "type": "integer"
          }
        },
        "required": [
          "subject",
          "category"
        ],
        "title": "IssueRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
